---
import siteData from '../data/site.json';
import NavbarMobile from '../components/react/NavbarMobile';

const { navigation } = siteData;
const currentPath = Astro.url.pathname;
---

<nav
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-transparent py-4"
>
  <div class="container mx-auto px-4 md:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3">
         <img id="nav-logo" src="/Icono.png" alt="Logo" class="h-12 md:h-14 w-auto object-contain cursor-pointer hover:scale-105 transition-transform duration-300" />
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-8">
        {navigation.map((item) => (
          <a 
            href={item.href} 
            class:list={[
              "text-black font-medium transition-all duration-200 relative group hover:text-[#559A95]",
              currentPath === item.href ? "text-[#559A95]" : ""
            ]}
          >
            {item.label}
            <span class:list={[
               "absolute -bottom-1 left-0 w-full h-0.5 bg-[#559A95] transition-transform duration-300 origin-left",
               currentPath === item.href ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"
            ]}></span>
          </a>
        ))}
      </div>

      <div class="hidden md:flex items-center">
         <a 
          href="#contacto" 
          class="bg-[#559A95] text-white px-5 py-2.5 rounded-lg font-medium transition-transform duration-300 hover:scale-105 hover:shadow-lg"
        >
          Agendar sesión
        </a>
      </div>

   

      <!-- Mobile Menu (React Component) -->
      <div class="md:hidden">
        <NavbarMobile 
            client:load 
            navLinks={navigation} 
            currentPath={currentPath} 
        />
      </div>
    </div>
  </div>
</nav>

<script>
  import gsap from 'gsap';

  const navbar = document.getElementById('navbar');

  // Scroll Effect: Transparent at top, solid when scrolling
  const updateNavbar = () => {
    if (window.scrollY > 50) {
      navbar?.classList.remove('bg-transparent', 'py-4');
      navbar?.classList.add('bg-white/95', 'backdrop-blur-md', 'shadow-sm', 'py-2');
    } else {
      navbar?.classList.add('bg-transparent', 'py-4');
      navbar?.classList.remove('bg-white/95', 'backdrop-blur-md', 'shadow-sm', 'py-2');
    }
  };

  window.addEventListener('scroll', updateNavbar);
  updateNavbar();

   // Initial Animation
  gsap.fromTo(navbar, 
    { y: -100, opacity: 0 },
    { y: 0, opacity: 1, duration: 1.0, ease: "power2.out" }
  );
</script>
