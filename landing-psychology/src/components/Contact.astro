---
import siteData from '../data/site.json';
const { form, email, phone, location } = siteData.contact;
---

<section id="contacto" class="relative py-20 bg-[#F9FAFB] overflow-hidden">
  <!-- Decorative Blobs -->
  <div class="blob-1 absolute top-10 left-10 w-32 h-32 bg-[#559A95]/10 rounded-full blur-xl z-0"></div>
  <div class="blob-2 absolute bottom-20 right-10 w-40 h-40 bg-[#61B39C]/10 rounded-full blur-xl z-0"></div>
  <div class="blob-3 absolute top-1/2 left-1/4 w-24 h-24 bg-[#559A95]/5 rounded-full blur-lg z-0"></div>
  <div class="blob-4 absolute bottom-1/3 right-1/4 w-36 h-36 bg-[#61B39C]/5 rounded-full blur-lg z-0"></div>

  <div class="container mx-auto px-6 max-w-6xl relative z-10">
    
    <div class="text-center mb-12">
      <span class="text-[#559A95] font-bold tracking-widest text-sm uppercase mb-3 block">Ubicación y Contacto</span>
      <h2 class="text-4xl md:text-5xl font-serif text-[#1a1a1a] mb-6">
        Estamos en Nicoya
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
      
      <!-- Contact Info Cards -->
      <div class="lg:col-span-1 flex flex-col gap-4">
        
        <!-- Phone / WhatsApp -->
        <a href="https://wa.me/50686869696" target="_blank" aria-label="Contactar por WhatsApp" class="flex items-center gap-4 p-5 bg-white rounded-2xl shadow-sm border border-gray-100 hover:shadow-md hover:border-[#559A95]/30 transition-all group">
          <div class="w-12 h-12 rounded-full bg-[#f0f7f6] flex items-center justify-center text-[#559A95] group-hover:bg-[#559A95] group-hover:text-white transition-colors duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
          </div>
          <div>
            <h3 class="font-serif text-lg text-gray-800 group-hover:text-[#559A95] transition-colors">WhatsApp</h3>
            <p class="text-gray-500 text-sm">8686-9696</p>
          </div>
        </a>

        <!-- Instagram Personal -->
        <a href="https://www.instagram.com/danielarodriguez_psicologa/" target="_blank" aria-label="Seguir en Instagram a Daniela Rodriguez" class="flex items-center gap-4 p-5 bg-white rounded-2xl shadow-sm border border-gray-100 hover:shadow-md hover:border-[#559A95]/30 transition-all group">
          <div class="w-12 h-12 rounded-full bg-[#f0f7f6] flex items-center justify-center text-[#559A95] group-hover:bg-[#559A95] group-hover:text-white transition-colors duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </div>
          <div>
            <h3 class="font-serif text-lg text-gray-800 group-hover:text-[#559A95] transition-colors">Sígueme</h3>
            <p class="text-gray-500 text-sm">@danielarodriguez_psicologa</p>
          </div>
        </a>

        <!-- Instagram Clinic -->
        <a href="https://www.instagram.com/clinicadreams.cr/" target="_blank" aria-label="Ver Clínica Dreams en Instagram" class="flex items-center gap-4 p-5 bg-white rounded-2xl shadow-sm border border-gray-100 hover:shadow-md hover:border-[#559A95]/30 transition-all group">
          <div class="w-12 h-12 rounded-full bg-[#f0f7f6] flex items-center justify-center text-[#559A95] group-hover:bg-[#559A95] group-hover:text-white transition-colors duration-300">
             <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"></path></svg>
          </div>
          <div>
            <h3 class="font-serif text-lg text-gray-800 group-hover:text-[#559A95] transition-colors">Clínica Dreams</h3>
            <p class="text-gray-500 text-sm">@clinicadreams.cr</p>
          </div>
        </a>

      </div>

      <!-- Google Maps Iframe -->
      <div class="lg:col-span-2 w-full h-[500px] rounded-3xl overflow-hidden shadow-xl shadow-gray-100/50 border border-gray-100 bg-white p-2">
        <iframe 
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3743.4027901637387!2d-85.4492964!3d10.1395783!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8f9fb7fc3dfc5725%3A0x780fcb8bc6cebe28!2sCl%C3%ADnica%20Dreams!5e1!3m2!1ses-419!2scr!4v1775849991338!5m2!1ses-419!2scr"
          width="100%" 
          height="100%" 
          style="border:0; border-radius: 1rem;" 
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade"
          title="Ubicación de Clínica Dreams en Nicoya, Guanacaste - Google Maps">
        </iframe>
      </div>

    </div>
  </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { validateForm } from '../utils/validators';

  gsap.registerPlugin(ScrollTrigger);

  // Background Organic Blobs
  gsap.to('.blob-1', {
    y: -10,
    rotation: 5,
    duration: 8,
    repeat: -1,
    yoyo: true,
    ease: "sine.inOut"
  });

  gsap.to('.blob-2', {
    y: 15,
    rotation: -5,
    duration: 9,
    repeat: -1,
    yoyo: true,
    ease: "sine.inOut",
    delay: 1
  });

  gsap.to('.blob-3', {
    scale: 1.05,
    rotation: 3,
    duration: 10,
    repeat: -1,
    yoyo: true,
    ease: "sine.inOut",
    delay: 2
  });

  gsap.to('.blob-4', {
    scale: 1.1,
    rotation: -3,
    duration: 11,
    repeat: -1,
    yoyo: true,
    ease: "sine.inOut",
    delay: 0.5
  });

  // Content Animations
  gsap.to('.contact-title', {
    opacity: 1,
    y: 0,
    duration: 0.8,
    ease: "power2.out",
    scrollTrigger: {
      trigger: '.contact-title',
      start: "top 85%",
      once: true
    }
  });

  // Form handling
  const form = document.getElementById('contact-form') as HTMLFormElement;
  if(form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const data = {
        name: formData.get('name') as string,
        email: formData.get('email') as string,
        phone: formData.get('phone') as string,
        message: formData.get('message') as string
      };
      
      const { valid } = validateForm(data);
      
      if (valid) {
        // Here you would typically send data to a backend
        alert('Gracias por tu mensaje. Te contactaremos pronto.');
        form.reset();
      } else {
        alert('Por favor verifica los campos.');
      }
    });

    // Simple interaction for inputs
    const inputs = form.querySelectorAll('input, textarea');
    inputs.forEach(input => {
      input.addEventListener('focus', () => {
        gsap.to(input, { scale: 1.01, duration: 0.2 });
      });
      input.addEventListener('blur', () => {
        gsap.to(input, { scale: 1, duration: 0.2 });
      });
    });
  }
</script>
