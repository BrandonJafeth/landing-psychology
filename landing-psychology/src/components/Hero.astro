---
import siteData from '../data/site.json';
const { hero } = siteData;
---

<section id="hero" class="relative w-full min-h-screen flex items-end justify-between bg-[#C8BDAE] overflow-hidden pt-20">
  
  <!-- Mobile Background Image -->
  <div class="absolute inset-0 z-0 md:hidden">
    <img 
      src="https://res.cloudinary.com/dkwvaxxdw/image/upload/v1768426070/_MG_1487_mtlt0e.jpg" 
      alt="Daniela Rodriguez" 
      class="w-full h-full object-cover object-top"
    />
    <div class="absolute inset-0 bg-black/20"></div>
  </div>
  
  <!-- Content Container -->
  <div class="container mx-auto px-6 md:px-12 relative z-20 flex flex-col-reverse md:flex-row h-full items-end">
    
    <!-- Left Text Side - Bottom Aligned -->
    <div class="w-full md:w-[55%] flex flex-col justify-end pb-12 md:pb-24 z-20">
      
      <h1 class="text-6xl md:text-7xl lg:text-9xl font-serif text-white leading-[0.9] mb-8">
        Daniela<br />Rodriguez
      </h1>

      <div class="md:max-w-xl">
           <p class="text-white/90 text-sm md:text-lg leading-relaxed mb-10 font-light tracking-wide">
            Lic. en Psicología, especializada en bienestar emocional y salud mental. 
            <br />
            {hero.subtitle}
          </p>
          
          <p class="text-white/90 font-serif italic text-lg md:text-xl mb-8">
            Atención en presencial o virtual.
          </p>

          <a 
            href="#contacto" 
            class="inline-block bg-[#559A95] text-white px-8 py-4 rounded-xl font-medium text-lg transition-all duration-300 hover:bg-[#457D79] hover:shadow-lg hover:-translate-y-0.5"
          >
            Contáctanos
          </a>
      </div>

    </div>

    <!-- Right Image Side -->
    <div class="desktop-only hidden md:flex w-full md:w-[45%] items-end justify-end relative h-[50vh] md:h-full">
        <!-- Image positioned at bottom -->
         <img 
          src={hero.image} 
          alt={hero.title}
          class="w-auto h-full md:h-[90vh] object-contain object-bottom drop-shadow-2xl translate-y-0"
        />
    </div>

  </div>

</section>

<style>
  @media (max-width: 768px) {
    .desktop-only {
      display: none !important;
    }
  }
</style>
