---
import siteData from '../data/site.json';
const { hero } = siteData;
---

<section id="hero" class="relative w-full min-h-screen bg-white overflow-hidden">
  
  <!-- Mobile Background Image (Full Screen with Overlay) -->
  <div class="md:hidden absolute inset-0 w-full h-full z-0">
      <img 
          src="https://res.cloudinary.com/dkwvaxxdw/image/upload/v1768426070/_MG_1487_mtlt0e.jpg" 
          alt="Daniela Rodriguez - Psicóloga en Nicoya, Guanacaste" 
          class="w-full h-full object-cover object-top"
      />
      <!-- Dark gradient overlay for text readability -->
      <div class="absolute inset-0 bg-black/40"></div>
  </div>

  <!-- Desktop Layout Container -->
  <div class="relative w-full h-full min-h-screen flex flex-col md:block">
    
    <!-- Left Side: Content -->
    <!-- 
      Mobile changes: 
      - bg-transparent (removed bg-white from base class)
      - h-screen (full height)
      - justify-end (text at bottom)
      - text-white (all text white on mobile)
    -->
    <div class="w-full md:w-3/4 lg:w-2/3 relative z-10 flex flex-col justify-end md:justify-center px-6 md:px-12 lg:px-24 pb-24 pt-20 md:py-32 md:bg-white h-screen">
      
      <div class="max-w-xl lg:max-w-2xl animate-fade-in-up">
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-serif text-white md:text-[#1a1a1a] leading-[1.1] mb-6">
          Daniela Rodríguez
          <span class="sr-only"> — Psicóloga en Nicoya, Guanacaste</span>
        </h1>

        <p class="text-white/90 md:text-[#333333] text-lg md:text-xl lg:text-2xl leading-relaxed mb-4 font-normal max-w-lg">
          Lic. en Psicología, especializada en bienestar emocional y salud mental en Nicoya, Guanacaste.
        </p>
        
        <p class="text-white/80 md:text-[#666666] font-serif italic text-lg lg:text-xl leading-relaxed mb-10 max-w-lg">
          Psicoterapia y capacitaciones para mejorar los estilos de vida y tener una vida más plena y saludable.
        </p>

        <div class="flex flex-col sm:flex-row gap-5 items-start sm:items-center">
          <a 
            href="/contacto" 
            class="inline-block bg-[#559A95] text-white px-6 py-4 rounded-lg font-medium text-xl transition-all duration-300 hover:bg-[#457D79] hover:shadow-lg hover:-translate-y-1 w-auto text-center"
          >
            Contáctanos
          </a>
          
    
        </div>
      </div>
    </div>

    <!-- Right Side: Image (Desktop) -->
    <!-- Z-index 20 to sit ON TOP of the text container.
         Clip-path creates the slanted edge revealing the content behind. -->
    <div class="hidden md:block absolute top-0 right-0 w-[55%] h-full z-20">
      <div class="w-full h-full relative" 
           style="clip-path: polygon(20% 0, 100% 0, 100% 100%, 0% 100%);">
           
           <img 
            src="https://res.cloudinary.com/dkwvaxxdw/image/upload/v1768407057/_MG_1556_xoka4k.jpg" 
            alt="Daniela Rodriguez Psicóloga en Nicoya - Consultorio Clínica Dreams Guanacaste"
            class="w-full h-full object-cover object-center"
          />
          
          <!-- Subtle overlay -->
          <div class="absolute inset-0 bg-black/5 mix-blend-multiply"></div>
      </div>
    </div>

  </div>

</section>

<style>
  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0;
    transform: translateY(20px);
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
