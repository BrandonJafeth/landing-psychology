---
import siteData from '../data/site.json';
const { about } = siteData;
---

<section id="sobre-mi" class="relative w-full py-12 md:py-20 lg:py-32 bg-white overflow-hidden">
  <div class="container mx-auto px-6 md:px-12">
    <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-20">
      
      <!-- Image Column -->
      <div class="w-full lg:w-1/2 relative flex justify-center lg:justify-end min-h-[500px] md:min-h-[600px]">
        <!-- Abstract Background Shapes -->
        <div 
          class="bg-shape-1 absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[400px] md:w-[500px] md:h-[500px] bg-[#61B39C]/10 rounded-full blur-3xl z-0"
        ></div>
        
        <div 
          class="bg-shape-2 absolute top-10 -right-10 w-40 h-40 bg-[#559A95]/5 rounded-full blur-2xl z-0"
        ></div>
        
        <!-- Image Container -->
        <div 
          class="image-container relative z-10 flex items-end justify-center lg:justify-end w-full max-w-[500px] lg:max-w-[550px]"
        >
          <!-- Main Image Wrapper -->
            <div class="relative w-full h-[500px] md:h-[600px] flex items-end overflow-hidden">
            <img 
              src={about.image} 
              alt={`Psicóloga ${about.titleHighlight}`} 
              class="w-full h-full object-contain object-bottom drop-shadow-2xl hover:scale-105 transition-transform duration-700"
            />
            
            {/* Gradient Overlay at Bottom */}
            <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-white via-white/50 to-transparent pointer-events-none z-10"></div>
            
            {/* Floating Badge */}
            <div 
              class="floating-badge absolute bottom-4 left-4 md:left-8 bg-white p-4 md:p-5 rounded-2xl shadow-xl border border-gray-100 max-w-[170px] z-20"
            >
              <div class="text-4xl font-bold text-[#559A95] mb-1 font-serif">
                {about.experience.years}
              </div>
              <div class="text-sm text-[#666666] leading-tight font-medium">
                {about.experience.label}
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Content Column -->
      <div class="content-column w-full lg:w-1/2 relative z-10">
        <div class="inline-block px-4 py-1.5 bg-[#559A95]/10 text-[#559A95] rounded-full text-sm font-semibold tracking-wide mb-6 uppercase">
          {about.sectionTag || 'Sobre Mí'}
        </div>
        
        <h2 class="text-4xl md:text-5xl font-serif text-[#1a1a1a] mb-8 leading-tight">
          { about.titlePrefix } <span class="text-[#559A95] italic">{ about.titleHighlight }</span>
        </h2>

        <div class="text-lg text-[#2c2c2c]/80 leading-relaxed font-light mb-10">
          <p>{about.description}</p>
        </div>

        <!-- Modalities -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-10">
          {about.modalities.map((modality) => (
            <div class="modality-card p-4 rounded-xl bg-gray-50 border border-gray-100 flex flex-col gap-2 transition-all duration-300">
                <div class="flex items-center gap-3">
                   <div class="w-8 h-8 rounded-full bg-white flex items-center justify-center text-[#559A95] shadow-sm">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                   </div>
                   <span class="font-medium text-[#333333]">{modality.title}</span>
               </div>
               <p class="text-sm text-[#666666] leading-tight pl-11">{modality.description}</p>
            </div>
          ))}
        </div>

        <a 
          href="#contacto" 
          class="inline-block px-8 py-4 bg-[#559A95] text-white rounded-md font-medium text-lg hover:bg-[#4A8A85] transition-all shadow-lg hover:shadow-[#559A95]/20 hover:-translate-y-1"
        >
          Conoce más sobre mi enfoque
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  
  gsap.registerPlugin(ScrollTrigger);

  // 1. Background Shapes (Infinite)
  gsap.to('.bg-shape-1', { scale: 1.1, duration: 4, repeat: -1, yoyo: true, ease: "sine.inOut" });
  gsap.to('.bg-shape-2', { scale: 1.05, duration: 5, repeat: -1, yoyo: true, ease: "sine.inOut", delay: 1 });

  // 2. Image Container Entrance
  gsap.fromTo('.image-container', 
    { y: 50, opacity: 0 },
    {
      y: 0, 
      opacity: 1, 
      duration: 1.2, 
      ease: "power2.out",
      scrollTrigger: {
        trigger: '.image-container',
        start: "top 85%",
        once: true
      }
    }
  );

  // 3. Floating Badge
  gsap.to('.floating-badge', { y: -10, duration: 2, repeat: -1, yoyo: true, ease: "sine.inOut" });

  // 4. Content Column Entrance
  gsap.fromTo('.content-column',
    { y: 50, opacity: 0 },
    {
      y: 0,
      opacity: 1,
      duration: 1.0, 
      ease: "power2.out",
      delay: 0.2,
      scrollTrigger: {
        trigger: '.content-column',
        start: "top 85%",
        once: true
      }
    }
  );

  // 5. Modalities Cards Hover
  const cards = document.querySelectorAll('.modality-card');
  cards.forEach((card) => {
    card.addEventListener('mouseenter', () => {
      gsap.to(card, { y: -5, boxShadow: "0 10px 30px -10px rgba(0,0,0,0.1)", duration: 0.3 });
    });
    card.addEventListener('mouseleave', () => {
      gsap.to(card, { y: 0, boxShadow: "none", duration: 0.3 });
    });
  });
</script>
