---
import { Image } from 'astro:assets';
import siteData from '../data/site.json';
const { about } = siteData;
---

<section id="sobre-mi" class="py-24 bg-white">
  <div class="container mx-auto px-4 md:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      
      <!-- Image Column -->
      <div class="relative w-full h-[600px] lg:h-[700px] shadow-xl order-last lg:order-first border-8 border-white bg-white">
        <Image 
          src="https://res.cloudinary.com/dkwvaxxdw/image/upload/v1768407201/_MG_1544_avmwex.jpg" 
          alt="Daniela Rodriguez - Psicóloga especialista en terapia individual y de pareja en Nicoya" 
          class="absolute inset-0 w-full h-full object-cover"
          width={800}
          height={700}
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Content Column -->
      <div class="flex flex-col justify-center px-4 md:px-8">
         <!-- Title Style -->
        <span class="text-gray-500 uppercase tracking-[0.2em] text-sm font-medium mb-4 block">
          Sobre Mí
        </span>
        
        <h2 
          class="text-4xl md:text-6xl text-[#559A95] font-serif mb-8 leading-none"
          aria-label="Hola, soy Daniela Rodriguez"
        >
          Hola, soy<br/> <span class="italic">Daniela Rodriguez</span>
        </h2>

        <div class="text-lg text-gray-600 leading-relaxed font-light mb-8">
          <p class="mb-6">
            {about.description}
          </p>
          <p>
            Creo firmemente en la capacidad humana para sanar y crecer. Mi objetivo es proporcionarte un espacio seguro donde puedas explorar tus pensamientos y emociones sin juicios.
          </p>
        </div>

        <div class="flex items-center gap-4 mb-10 pl-4 border-l-4 border-[#559A95]">
           <p class="text-[#1a1a1a] italic font-medium text-lg leading-none">
             Atención en modalidad presencial o virtual.
           </p>
        </div>

        <div>
           <a 
            href="/contacto" 
            class="inline-block px-8 py-3 bg-[#559A95] text-white rounded-full font-medium transition-transform duration-300 hover:scale-105 hover:shadow-lg"
            aria-label="Conoce más sobre mi enfoque terapéutico"
          >
            Conoce más sobre mi enfoque
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
