---
import { Image } from 'astro:assets';
import siteData from '../data/site.json';
const { navigation, contact, social, footer } = siteData;
---

<footer class="bg-primary text-white relative overflow-hidden">
  <!-- Decorative Blobs -->
  <div class="blob-1 absolute top-20 left-10 w-40 h-40 bg-white/10 rounded-full blur-2xl"></div>
  <div class="blob-2 absolute top-1/3 right-20 w-56 h-56 bg-secondary/20 rounded-full blur-3xl"></div>
  <div class="blob-3 absolute bottom-32 left-1/4 w-32 h-32 bg-white/10 rounded-full blur-xl"></div>
  <div class="blob-4 absolute bottom-20 right-1/3 w-48 h-48 bg-accent/15 rounded-full blur-2xl"></div>

  <!-- Decorative Shapes -->
  <div class="shape-1 absolute top-40 right-1/4 w-20 h-20 bg-white/10 rounded-full"></div>
  <div class="shape-2 absolute top-60 left-1/4 w-24 h-20 bg-secondary/15 rounded-[40%_60%_70%_30%/40%_50%_60%_50%]"></div>
  <div class="shape-3 absolute bottom-40 left-20 w-36 h-28 bg-white/10 rounded-[50%_50%_50%_50%/60%_60%_40%_40%]"></div>


  <!-- Main Footer Content -->
  <div class="relative z-10 border-t border-white/20 py-12 px-6">
    <div class="max-w-7xl mx-auto grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-12">
      
      <!-- Brand Section -->
      <div class="footer-grid-item col-span-2 lg:col-span-1">
        <div class="flex items-center gap-3 mb-4">
          <Image src="/Icono%20blanco.png" alt="Daniela Rodriguez Psicóloga - Logo" class="h-12 md:h-14 w-auto object-contain" width={56} height={56} loading="lazy" decoding="async" />
        </div>
        <p class="text-white/70 text-sm leading-relaxed">
          {siteData.meta.description}
        </p>
      </div>

      <!-- Navigation -->
      <div class="footer-grid-item col-span-1">
        <h4 class="text-lg font-semibold mb-4">Navegación</h4>
        <nav class="space-y-2">
          {navigation.map((item) => (
            <a
              href={item.href}
              class="block text-white/70 hover:text-white transition-colors duration-300 text-sm"
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>

      <!-- Contact Info -->
      <div class="footer-grid-item col-span-1">
        <h4 class="text-lg font-semibold mb-4">Contacto</h4>
        <div class="space-y-3">
          <a 
            href={`mailto:${contact.email}`}
            class="flex items-center gap-2 text-white/70 hover:text-white transition-colors duration-300 text-sm group"
          >
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span class="group-hover:underline">{contact.email}</span>
          </a>
          
          <a 
            href={`tel:${contact.phone.replace(/\s/g, '')}`}
            class="flex items-center gap-2 text-white/70 hover:text-white transition-colors duration-300 text-sm group"
          >
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span class="group-hover:underline">{contact.phone}</span>
          </a>
          
          <div class="flex items-center gap-2 text-white/70 text-sm">
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{contact.location}</span>
          </div>
        </div>
      </div>

      <!-- Social Media -->
      <div class="footer-grid-item col-span-2 lg:col-span-1">
        <h4 class="text-lg font-semibold mb-4">Sígueme</h4>
        <div class="flex gap-4">
          <a
            href={social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="social-icon w-10 h-10 bg-white/10 rounded-lg flex items-center justify-center hover:bg-white/20 transition-colors duration-300"
            aria-label="Instagram"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </a>

          <a
            href={social.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="social-icon w-10 h-10 bg-white/10 rounded-lg flex items-center justify-center hover:bg-white/20 transition-colors duration-300"
            aria-label="Facebook"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>

          <a
            href={social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="social-icon w-10 h-10 bg-white/10 rounded-lg flex items-center justify-center hover:bg-white/20 transition-colors duration-300"
            aria-label="LinkedIn"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
        </div>
        
        <p class="mt-6 text-sm text-white/60">
          Recibe consejos de bienestar
        </p>
      </div>

    </div>
  </div>

  <!-- Bottom Bar -->
  <div 
    class="footer-bottom relative z-10 border-t border-white/20 py-6 px-6"
  >
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-center items-center gap-4 text-sm text-white/60">
      <p>{footer.copyright}</p>
      <a 
        href="https://www.instagram.com/one.out_/" 
        target="_blank" 
        rel="noopener noreferrer"
        class="flex items-center gap-2 hover:opacity-80 transition-opacity duration-300"
        aria-label="One Out en Instagram"
      >
        <Image 
          src="https://res.cloudinary.com/dxrzwnjee/image/upload/v1771954550/0241f761-da98-4ff8-ab80-3faa665f3a00.png" 
          alt="One Out Logo" 
          class="h-8 w-auto object-contain"
          width={32}
          height={32}
          loading="lazy"
          decoding="async"
        />
      </a>
      <p>{footer.rights}</p>
    </div>
  </div>
</footer>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  
  gsap.registerPlugin(ScrollTrigger);

  // Decorative Blobs & Shapes (Infinite Animations)
  const infiniteAnimations = [
    { selector: '.blob-1', vars: { y: -20, duration: 8, delay: 0 } },
    { selector: '.blob-2', vars: { y: -25, duration: 9, delay: 1 } },
    { selector: '.blob-3', vars: { scale: 1.1, duration: 7, delay: 0.5 } },
    { selector: '.blob-4', vars: { x: 15, y: -10, duration: 10, delay: 1.5 } },
    { selector: '.shape-1', vars: { y: -15, rotation: 5, duration: 8, delay: 0 } },
    { selector: '.shape-2', vars: { y: 20, rotation: -5, duration: 9, delay: 0.5 } },
    { selector: '.shape-3', vars: { scale: 1.05, rotation: 3, duration: 10, delay: 2 } },
  ];

  infiniteAnimations.forEach(({ selector, vars }) => {
    gsap.to(selector, { ...vars, repeat: -1, yoyo: true, ease: "sine.inOut" });
  });

  // Staggered Entrance Animations
  const fadeIn = (selector: string, delay = 0, triggerStart = "top 90%") => {
    gsap.from(selector, {
      opacity: 0, 
      y: 30, 
      duration: 0.8, 
      stagger: 0.1, 
      ease: "power2.out",
      delay: delay,
      scrollTrigger: {
        trigger: selector,
        start: triggerStart,
        once: true
      }
    });
  };

  fadeIn('.footer-grid-item', 0.2, "top 85%");
  fadeIn('.footer-bottom', 0.3, "top 95%");

  // Hover handlers for social icons
  const socialIcons = document.querySelectorAll('.social-icon');
  socialIcons.forEach((icon) => {
    icon.addEventListener('mouseenter', () => gsap.to(icon, { scale: 1.1, duration: 0.2 }));
    icon.addEventListener('mouseleave', () => gsap.to(icon, { scale: 1, duration: 0.2 }));
  });

</script>
