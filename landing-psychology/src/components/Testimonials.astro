---
import testimonialsData from '../data/testimonials.json';
---

<section id="testimonios" class="relative py-12 md:py-20 px-6 bg-white overflow-hidden">
  <!-- Background Text -->
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none overflow-hidden opacity-50">
    <h2 class="text-[4rem] sm:text-[6rem] md:text-[9rem] lg:text-[12rem] xl:text-[15rem] font-bold text-[#F5F5F5] select-none leading-none whitespace-nowrap px-4">
      {testimonialsData.section.background}
    </h2>
  </div>

  <!-- Content -->
  <div class="relative z-10 max-w-7xl mx-auto">
    <!-- Title -->
    <div 
      class="testimonial-title text-center mb-16 opacity-0 translate-y-[50px]"
    >
      <h2 class="text-3xl md:text-5xl font-bold text-[#2C2C2C] mb-3">
        {testimonialsData.section.title}{' '}
        <span class="text-[#559A95]">{testimonialsData.section.subtitle}</span>
      </h2>
    </div>

    <!-- Testimonials Grid -->
    <div 
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-6 lg:gap-8 max-w-5xl mx-auto"
    >
      {testimonialsData.testimonials.map((testimonial) => (
        <div
          class="testimonial-card group relative opacity-0 translate-y-[50px]"
        >
          <div class="bg-white rounded-2xl p-6 shadow-sm hover:shadow-xl transition-shadow duration-300 border border-gray-100 h-full">
            <!-- Quote Icon -->
            <div 
              class="quote-icon absolute -top-3 -left-3 w-10 h-10 bg-[#559A95] rounded-full flex items-center justify-center shadow-md transition-transform duration-300 group-hover:scale-110 group-hover:rotate-12"
            >
              <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
              </svg>
            </div>

            <!-- Image -->
            <div class="flex justify-center mb-4 mt-4">
              <div 
                class="relative w-20 h-20 rounded-full overflow-hidden border-4 border-[#559A95]/20 group-hover:scale-110 group-hover:rotate-3 transition-transform duration-300"
              >
                <div class="w-full h-full bg-gradient-to-br from-[#559A95] to-[#61B39C] flex items-center justify-center text-white text-2xl font-bold">
                   {/* Fallback initials or image */}
                   { testimonial.image ? <img src={testimonial.image} alt={testimonial.name} class="w-full h-full object-cover" /> : testimonial.name.charAt(0) }
                </div>
              </div>
            </div>

            <!-- Content -->
            <div class="text-center">
              <p class="text-[#2c2c2c]/80 text-lg italic mb-6 leading-relaxed font-serif">
                "{testimonial.text}"
              </p>
              
              <div class="border-t border-gray-100 pt-4">
                 <h4 class="text-[#1a1a1a] font-bold text-lg mb-1">{testimonial.name}</h4>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  
  gsap.registerPlugin(ScrollTrigger);

  // Title Animation
  gsap.to('.testimonial-title', {
    opacity: 1,
    y: 0,
    duration: 0.8,
    ease: "power2.out",
    scrollTrigger: {
      trigger: '.testimonial-title',
      start: "top 85%",
      once: true
    }
  });

  // Cards Staggered Animation
  gsap.to('.testimonial-card', {
    opacity: 1,
    y: 0,
    duration: 0.8,
    stagger: 0.2,
    ease: "power2.out",
    scrollTrigger: {
      trigger: '#testimonios',
      start: "top 75%",
      once: true
    }
  });

  // Hover effects (JavaScript based to mimic complex Framer Motion if needed, but CSS covers most)
  // CSS group-hover handled most of it.
  
  // Card Hover lift
  const cards = document.querySelectorAll('.testimonial-card > div');
  cards.forEach((card) => {
    card.addEventListener('mouseenter', () => {
      gsap.to(card, { y: -8, scale: 1.02, duration: 0.3, ease: "power1.out" });
    });
    card.addEventListener('mouseleave', () => {
      gsap.to(card, { y: 0, scale: 1, duration: 0.3, ease: "power1.out" });
    });
  });

</script>
