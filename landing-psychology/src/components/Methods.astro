---
import { Image } from 'astro:assets';
import methodsData from '../data/methods.json';

const { methods } = methodsData;
---

<section id="metodos" class="py-24 bg-white">
  <div class="container mx-auto px-4 md:px-8">
    
    <!-- Encabezado de Sección -->
    <div class="text-center mb-20">
      <span class="text-gray-500 uppercase tracking-widest text-sm font-medium">
        Formación y enfoque
      </span>
      <h2 class="text-4xl md:text-5xl text-[#559A95] mt-4 font-serif">
        Mis métodos
      </h2>
    </div>

    <!-- Grid de Métodos -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {methods.map((method) => (
        <div class="flex flex-col gap-6 p-8 border-l border-b border-gray-200 hover:border-[#559A95] hover:shadow-sm transition-all duration-300 group bg-white">
          
          <div class="flex items-center gap-4">
             <!-- Columna Icono -->
            <div class="shrink-0 w-14 h-14 flex items-center justify-center">
              <Image 
                src={method.icon} 
                alt={method.title} 
                class="w-full h-full object-contain opacity-80 group-hover:opacity-100 transition-opacity" 
                width={56}
                height={56}
                loading="lazy"
                decoding="async"
              />
            </div>
             <!-- Titulo -->
            <h3 class="text-xl text-gray-800 font-serif leading-tight group-hover:text-[#559A95] transition-colors">
              {method.title}
            </h3>
          </div>

          <!-- Columna Texto -->
          <div>
            <p class="text-gray-600 leading-relaxed mb-6 font-light text-sm">
              {method.description}
            </p>
            <div class="w-10 h-0.5 bg-[#559A95] opacity-30 group-hover:opacity-100 group-hover:w-20 transition-all duration-300 mb-2"></div>
            <p class="text-[#559A95] font-medium text-xs">
              {method.highlight}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
