---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const seo = {
  title: "Contacto | Daniela Rodriguez - Psicóloga Clínica",
  description: "Agenda tu cita o realiza tus consultas. Atención en Inglés y Español, presencial o virtual.",
};
---

<Layout>
  <Navbar />
  
  <main class="py-20 md:py-28 bg-[#faf9f6]">
    <div class="container mx-auto px-6 max-w-7xl">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        
        <!-- Mobile Title (Visible only on mobile) -->
        <div class="lg:hidden text-center mb-2 order-1">
          <h1 class="text-4xl font-serif text-[#333333] mb-4 leading-tight">
            Envíame un <br /> mensaje
          </h1>
        </div>

        <!-- Image Column (Left) -->
        <div class="relative w-full h-[500px] md:h-[600px] lg:h-[800px] shadow-2xl order-2 lg:order-first border-[12px] border-white bg-white rotate-1 hover:rotate-0 transition-transform duration-500 ease-out">
          <img 
            src="https://res.cloudinary.com/dkwvaxxdw/image/upload/v1768513005/_MG_1516_wzhny2.jpg" 
            alt="Consultorio Daniela Rodriguez" 
            class="absolute inset-0 w-full h-full object-cover"
          />
        </div>

        <!-- Content Column (Right) -->
        <div class="flex flex-col justify-center lg:pl-10 order-3">
          
          <div class="mb-10 hidden lg:block">
            <span class="text-[#559A95] uppercase tracking-[0.2em] text-sm font-semibold mb-4 block">
              Contacto
            </span>
            <h1 class="text-4xl md:text-6xl font-serif text-[#333333] mb-6 leading-tight">
              Envíame un <br /> mensaje
            </h1>
            <p class="text-lg text-[#666666] font-light leading-relaxed mb-8">
              Estoy aquí para escucharte. Ya sea que busques agendar una cita o tengas preguntas sobre el proceso terapéutico.
            </p>

            <!-- Compact Contact Info Removed -->
          </div>

          <!-- Contact Form -->
          <div class="bg-white p-6 md:p-10 rounded-xl shadow-lg border border-gray-100 relative -mt-6 lg:mt-0 z-10 w-[95%] mx-auto lg:w-full">
            <form id="contact-form" class="space-y-5">
              <div class="grid md:grid-cols-2 gap-5">
                <div>
                  <label for="name" class="block text-xs font-bold text-[#559A95] uppercase tracking-wider mb-2">Nombre</label>
                  <input 
                    type="text" 
                    id="name" 
                    name="name" 
                    class="w-full px-4 py-3 bg-gray-50 border-b-2 border-gray-200 focus:border-[#559A95] outline-none transition-colors duration-300 font-serif placeholder:text-gray-400"
                    placeholder="Tu nombre"
                  />
                  <p id="error-name" class="text-red-500 text-xs mt-1 hidden font-sans"></p>
                </div>
                <div>
                  <label for="phone" class="block text-xs font-bold text-[#559A95] uppercase tracking-wider mb-2">Teléfono</label>
                  <input 
                    type="tel" 
                    id="phone" 
                    name="phone" 
                    class="w-full px-4 py-3 bg-gray-50 border-b-2 border-gray-200 focus:border-[#559A95] outline-none transition-colors duration-300 font-serif placeholder:text-gray-400"
                    placeholder="+506 ...."
                  />
                  <p id="error-phone" class="text-red-500 text-xs mt-1 hidden font-sans"></p>
                </div>
              </div>

              <div>
                <label for="email" class="block text-xs font-bold text-[#559A95] uppercase tracking-wider mb-2">Correo</label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  class="w-full px-4 py-3 bg-gray-50 border-b-2 border-gray-200 focus:border-[#559A95] outline-none transition-colors duration-300 font-serif placeholder:text-gray-400"
                  placeholder="tu@email.com"
                />
                <p id="error-email" class="text-red-500 text-xs mt-1 hidden font-sans"></p>
              </div>

              <div>
                <label for="message" class="block text-xs font-bold text-[#559A95] uppercase tracking-wider mb-2">Mensaje</label>
                <textarea 
                  id="message" 
                  name="message" 
                  rows="3" 
                  class="w-full px-4 py-3 bg-gray-50 border-b-2 border-gray-200 focus:border-[#559A95] outline-none transition-colors duration-300 font-serif placeholder:text-gray-400 font-sans resize-none"
                  placeholder="¿En qué puedo ayudarte?"
                ></textarea>
                <p id="error-message" class="text-red-500 text-xs mt-1 hidden font-sans"></p>
              </div>

              <button 
                type="submit"
                id="submit-btn"
                class="w-full py-4 px-6 bg-[#559A95] hover:bg-[#4A8A85] text-white font-medium transition-all duration-300 shadow-md hover:shadow-lg flex justify-center items-center gap-2 uppercase tracking-widest text-sm mt-4"
              >
                <span>Enviar Mensaje</span>
              </button>

              <div id="form-status" class="hidden p-4 rounded-lg text-sm text-center mt-4"></div>
            </form>
          </div>
          
        </div>

      </div>
    </div>
  </main>
  
  <Footer />
</Layout>

<script>
  import { validateForm } from '../utils/validators';

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const statusEl = document.getElementById('form-status');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const originalBtnText = submitBtn.innerHTML;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    // Reset status and errors
    if (statusEl) {
        statusEl.classList.add('hidden');
        statusEl.className = 'hidden p-4 rounded-lg text-sm text-center';
    }
    document.querySelectorAll('[id^="error-"]').forEach(el => el.classList.add('hidden'));
    
    const formData = new FormData(form);
    const data = Object.fromEntries(formData) as Record<string, string>;

    // Client-side validation
    const validation = validateForm(data);
    if (!validation.valid) {
      Object.entries(validation.errors).forEach(([key, msg]) => {
         const errorEl = document.getElementById(`error-${key}`);
         if (errorEl) {
           errorEl.textContent = msg;
           errorEl.classList.remove('hidden');
         }
      });
      return;
    }
    
    // Disable button
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="animate-pulse">Enviando...</span>';

    try {
      const response = await fetch('/api/send-email', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(data),
      });

      const result = await response.json();

      if (response.ok) {
        if (statusEl) {
            statusEl.textContent = '¡Mensaje enviado con éxito! Te contactaré pronto.';
            statusEl.classList.remove('hidden');
            statusEl.classList.add('bg-green-50', 'text-green-700', 'border', 'border-green-200');
        }
        form.reset();
      } else {
        throw new Error(result.message || 'Error al enviar el mensaje');
      }
    } catch (error: any) {
      if (statusEl) {
          statusEl.textContent = error.message || 'Hubo un error. Por favor intenta de nuevo.';
          statusEl.classList.remove('hidden');
          statusEl.classList.add('bg-red-50', 'text-red-700', 'border', 'border-red-200');
      }
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerHTML = originalBtnText;
    }
  });
</script>
